#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D textures[AR_SET_IMAGE_COUNT];
layout(set = 0, binding = 1) uniform sampler samplers[AR_SET_SAMPLER_COUNT];
layout(std430, set = 0, binding = 2) writeonly buffer Output {
    vec4 samples[];
} outputData;

layout(push_constant) uniform Query {
    uint imageSlot;
    uint samplerSlot;
    uint outputIndex;
    uint reserved;
    vec2 uv;
} query;

void main() {
    outputData.samples[query.outputIndex] = textureLod(
        sampler2D(
            textures[nonuniformEXT(query.imageSlot)],
            samplers[nonuniformEXT(query.samplerSlot)]),
        query.uv,
        0.0);
}
